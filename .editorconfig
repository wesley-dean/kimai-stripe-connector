root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
curly_bracket_next_line = false
spaces_around_operators = true
indent_brace_style = K&R
indent_size = 2
tab_width = 2
max_line_length = 88

# PHP follows PSR-12 indentation.
[*.php]
indent_style = space
indent_size = 4
tab_width = 4

# Bash scripts
[{.,}*.{sh,bash}]
indent_style = space
indent_size = 2
line_comment = #
block_comment_start = ##
block_comment_end = ##
block_comment = ##

# Python files
[{.,}*.{py,pyw}]
indent_size = 4
tab_width = 4
line_comment = #
block_comment_start = """
block_comment = """

# Markdown prose intentionally permits long narrative lines.  Markdown also
# contains fenced diagrams and examples whose indentation is semantic, so a
# repository-wide indentation multiple is not applicable inside these files.
[{.,}*.{md,markdown}]
indent_size = unset
max_line_length = 999
trim_trailing_whitespace = false
insert_final_newline = true
block_comment_start = <!---
block_comment_end = -->

# Make recipes require literal tabs.
[Makefile]
indent_style = tab
indent_size = tab

[*.mk]
indent_style = tab
indent_size = tab

# XML configuration files use four-space nesting in this project.
[{.,}**.{xml,config,props,targets,nuspec,resx,ruleset,vsixmanifest,vsct}]
indent_size = 4
block_comment_start = <!--
block_comment_end = -->

# JSON strings and generated metadata may legitimately exceed source-code line
# length.  Formatting remains enforced by Prettier/jsonlint.
[{.,}*.{json,json5,webmanifest}]
indent_size = 2
max_line_length = 999

# YAML files
[{.,}*.{yaml,yml}]
indent_style = space
indent_size = 2
line_comment = #

# JavaScript files
[{.,}*.{js,jsx}]
indent_style = space
indent_size = 2
line_comment = //
block_comment_start = /**
block_comment = *
block_comment_end = */

# Ignore-pattern files contain literal patterns rather than prose/source lines.
[.gitignore]
max_line_length = 999
