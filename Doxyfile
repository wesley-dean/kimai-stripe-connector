# Doxygen configuration for Kimai Stripe Connector PHP source.

PROJECT_NAME           = "Kimai Stripe Connector"
PROJECT_BRIEF          = "Kimai and Stripe Payment Link connector reference documentation"

OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.php

EXCLUDE                = vendor \
                         tests \
                         doc/reference
EXCLUDE_PATTERNS       = */vendor/* \
                         */tests/* \
                         */doc/reference/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
