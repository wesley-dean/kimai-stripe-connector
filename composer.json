{
  "name": "wesley-dean/kimai-stripe-connector",
  "description": "Kimai plugin for Stripe Payment Links and conservative payment reconciliation",
  "type": "kimai-plugin",
  "license": "CC0-1.0",
  "authors": [
    {
      "name": "Wes Dean"
    }
  ],
  "require": {
    "php": ">=8.2 <8.6",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "stripe/stripe-php": "^21.3.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.24",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0.4",
    "symfony/config": "6.4.*",
    "symfony/dependency-injection": "6.4.*",
    "symfony/http-kernel": "6.4.*",
    "symfony/yaml": "6.4.*"
  },
  "autoload": {
    "psr-4": {
      "KimaiPlugin\\KimaiStripeConnectorBundle\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/stubs/App/",
      "KimaiStripeConnectorTests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer check --diff --verbose",
    "lint": "phpcs --standard=phpcs.xml",
    "test": "phpunit",
    "check": [
      "@test",
      "@analyse",
      "@lint",
      "@format:check"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "kimai": {
      "require": 26500,
      "name": "Kimai Stripe Connector"
    }
  }
}
